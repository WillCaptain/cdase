{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/session-start.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/before-submit-sync.sh"
      }
    ],
    "beforeReadFile": [
      {
        "command": "./hooks/before-read-roster.sh",
        "matcher": "users\\.context\\.md"
      }
    ]
  }
}
