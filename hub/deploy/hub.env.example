# CDASE Hub server configuration — copy to /cdase-hub/hub.env.
# Never commit real credentials.

# Internal relational API Pool (PostgreSQL + pgvector).
CDASE_KB_PROVIDER=postgres
CDASE_KB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/cdase_api_pool
CDASE_KB_JDBC_USER=cdase
CDASE_KB_JDBC_PASSWORD=replace-me

# Authenticates API reserve/update/lifecycle writes through the Hub.
CDASE_KB_WRITE_TOKEN=replace-with-a-long-random-token

# OpenAI-compatible local embedding endpoint hosting BAAI/bge-small-en-v1.5.
CDASE_EMBEDDING_URL=http://127.0.0.1:8081/v1/embeddings
CDASE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CDASE_EMBEDDING_TOKEN=

# To relocate the Hub to an existing HTTP knowledge database, replace the
# PostgreSQL settings above with:
# CDASE_KB_PROVIDER=http
# CDASE_KB_HTTP_URL=https://legacy.example/knowledge
# CDASE_KB_HTTP_TOKEN=replace-me
